<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 默认控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
<!--            <pattern>%magenta(%d{yyyy-MM-dd HH:mm:ss.SSS}) %yellow([%thread]) %highlight(%-5level) %green(%logger) [%X{queryId}] - %msg%n</pattern>-->
            <pattern>%magenta(%d{yyyy-MM-dd HH:mm:ss.SSS}) %yellow([%thread]) %highlight(%-5level) %green(%class.%method:%line) [%X{queryId}] - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Widdo Nexus 专用日志设置 -->
    <logger name="cn.widdo.nexus" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 数据库查询日志单独配置 -->
    <logger name="cn.widdo.nexus.core.query" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 事务日志单独配置 -->
    <logger name="cn.widdo.nexus.core.transaction" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 根日志设置 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 开发环境特殊配置 -->
    <springProfile name="dev">
        <logger name="cn.widdo.nexus" level="DEBUG"/>
        <logger name="cn.widdo.nexus.core.query" level="TRACE"/>

        <!-- 添加彩色日志 -->
        <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
        <property name="CONSOLE_LOG_PATTERN"
                  value="${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){blue} %clr(%-5level){green} %clr(%logger{36}){cyan} [%X{queryId}] %clr(-){faint} %msg%n}"/>
    </springProfile>

    <!-- 生产环境特殊配置 -->
    <springProfile name="prod">
        <logger name="cn.widdo.nexus" level="INFO"/>
        <logger name="cn.widdo.nexus.core.query" level="WARN"/>

        <!-- 添加JSON格式日志输出 -->
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeContext>false</includeContext>
                <includeMdc>true</includeMdc>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <message>message</message>
                    <thread>thread</thread>
                    <logger>logger</logger>
                    <level>level</level>
                    <levelValue>level_value</levelValue>
                    <mdc>mdc</mdc>
                </fieldNames>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>